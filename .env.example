# Copia questi nomi nelle Variables del servizio su Railway (i valori NON vanno mai nel repository)
SERVICE_TOKEN=          # una password lunga inventata da te: n8n la manda nell'header X-Token
KIE_API_KEY=            # Kie AI
OPENAI_API_KEY=         # platform.openai.com (credito API, non l'abbonamento ChatGPT)
OPENAI_VISION_MODEL=gpt-6-astra
OPENAI_PRICE_IN_PER_M=  # facoltativo: $ per 1M token in ingresso, per il registro costi
OPENAI_PRICE_OUT_PER_M= # facoltativo: $ per 1M token in uscita
SUPABASE_URL=https://nerfwrxouzqrabtjszbp.supabase.co
SUPABASE_SERVICE_KEY=   # Supabase -> Project Settings -> API -> service_role (segreta)
SUPABASE_REFS_BUCKET=youtube_short
SUPABASE_VIDEO_BUCKET=youtube_short
SUPABASE_VIDEO_PREFIX=video
BUFFER_API_KEY=         # publish.buffer.com/settings/api
BUFFER_API_URL=https://api.buffer.com
N8N_WEBHOOK_URL=        # webhook del workflow n8n che riceve gli eventi
CHANNEL=lunaleo
DATA_DIR=/data          # monta qui un Volume Railway
