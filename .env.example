# Copia questi nomi nelle Variables del servizio su Railway (i valori NON vanno mai nel repository)
SERVICE_TOKEN=          # una password lunga inventata da te: n8n la manda nell'header X-Token
KIE_API_KEY=            # Kie AI
OPENAI_API_KEY=         # platform.openai.com (credito API, non l'abbonamento ChatGPT)
OPENAI_VISION_MODEL=gpt-6-astra
OPENAI_PRICE_IN_PER_M=  # facoltativo: il listino di gpt-6-astra/sol/luna è già nel codice (config.py)
OPENAI_PRICE_OUT_PER_M= # facoltativo: idem
SUPABASE_URL=https://nerfwrxouzqrabtjszbp.supabase.co
SUPABASE_SERVICE_KEY=   # Supabase -> Project Settings -> API -> service_role (segreta)
SUPABASE_REFS_BUCKET=youtube_short
SUPABASE_VIDEO_BUCKET=youtube_short
SUPABASE_VIDEO_PREFIX=video
BUFFER_API_KEY=         # publish.buffer.com/settings/api
BUFFER_API_URL=https://api.buffer.com
UPSCALE_PROVIDER=seedance # finale di "Approva": seedance (come prima) oppure fal (bozza 480p + upscale SeedVR2)
FAL_KEY=                # fal.ai -> API keys (serve per /upscale e per UPSCALE_PROVIDER=fal)
FAL_UPSCALE_NOISE=0.05  # facoltativo: 0 = più fedele alla bozza
FAL_UPSCALE_SEED=42     # facoltativo: seed fisso, risultati ripetibili
UPSCALE_FIX_VF=eq=saturation=0.86,hqdn3d=0:0:4:4  # facoltativo: correzione prima del grade (tarata su EP028)
N8N_WEBHOOK_URL=        # webhook del workflow n8n che riceve gli eventi
CHANNEL=lunaleo
DATA_DIR=/data          # monta qui un Volume Railway
TELEGRAM_BOT_TOKEN=     # da @BotFather
TELEGRAM_CHAT_ID=       # scrivi /id al bot e copia il numero
OPENAI_IDEAS_MODEL=gpt-6.1-sol  # facoltativo: modello per /idee e /brainstorming (giudice e /nuovo restano su OPENAI_VISION_MODEL)
STORYBOARD_STYLE_REF=storyboard/stile_storyboard.png  # facoltativo: immagine di stile dello storyboard nel bucket delle tavole
STORYBOARD_MODEL=nano-banana-pro  # facoltativo: modello immagine su Kie per i pannelli
STORYBOARD_RESOLUTION=1K  # facoltativo: 1K / 2K
